          "column": "is_opp"
        },
        {
          "label": "Won",
          "agg": "sum",
          "column": "is_won"
        },
        {
          "label": "Pipeline",
          "agg": "sum",
          "column": "pipeline_eur",
          "format": "eur"
        },
        {
          "label": "Won revenue",
          "agg": "sum",
          "column": "won_value_eur",
          "format": "eur"
        },
        {
          "label": "Spend",
          "agg": "lookup",
          "table": "Spend by channel",
          "key": "channel",
          "column": "spend_eur",
          "format": "eur"
        },
        {
          "label": "SQL rate",
          "ratio": [
            "SQLs",
            "Leads"
