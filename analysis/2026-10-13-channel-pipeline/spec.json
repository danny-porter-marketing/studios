{
  "title": "Which channels and content produce pipeline, Jan to Sep 2026",
  "clean_csv": "clean.csv",
  "raw_csv": "raw.csv",
  "extra_tables": [
    {
      "name": "Spend by channel",
      "csv": "spend_by_channel.csv"
    },
    {
      "name": "Spend by campaign",
      "csv": "spend_by_campaign.csv"
    },
    {
      "name": "Raw spend",
      "csv": "raw_spend.csv"
    }
  ],
  "kpis": [
    {
      "label": "Pipeline created",
      "agg": "sum",
      "column": "pipeline_eur",
      "format": "eur"
    },
    {
      "label": "Won revenue",
      "agg": "sum",
      "column": "won_value_eur",
      "format": "eur"
    },
    {
      "label": "SQLs",
      "agg": "sum",
      "column": "is_sql"
    },
    {
      "label": "Opportunities",
      "agg": "sum",
      "column": "is_opp"
    },
    {
      "label": "Spend",
      "agg": "sum_table",
      "table": "Spend by channel",
      "column": "spend_eur",
      "format": "eur"
    },
    {
      "label": "Cost per SQL",
      "ratio": [
        "Spend",
        "SQLs"
      ],
      "format": "eur"
    },
    {
      "label": "Pipeline per € spent",
      "ratio": [
        "Pipeline created",
        "Spend"
      ],
      "format": "dec"
    },
    {
      "label": "Leads",
      "agg": "count"
    }
  ],
  "breakdowns": [
    {
      "title": "By channel",
      "group_by": "channel",
      "sort_by": "Pipeline",
      "metrics": [
        {
          "label": "Leads",
