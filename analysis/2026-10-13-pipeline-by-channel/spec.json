        },
        {
          "label": "Cost per SQL",
          "ratio": [
            "Spend",
            "SQLs"
          ],
          "format": "eur",
          "highlight": "low_good"
        }
      ],
      "chart": {
        "metric": "SQLs"
      }
    },
    {
