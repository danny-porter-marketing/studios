{
  "title": "Pipeline by channel, campaign and content, Jan to Sep 2026",
  "question": "Which channels, campaigns and content actually produce pipeline, not just leads?",
  "subtitle": "1,400 leads and €222k spend, 5 Jan to 12 Sep 2026. Pipeline counts deals that reached Opportunity or beyond.",
  "clean_csv": "clean.csv",
  "raw_csv": "raw.csv",
  "extra_tables": [
    {
      "name": "Spend by channel",
      "csv": "spend_by_channel.csv"
    },
    {
      "name": "Spend by campaign",
      "csv": "spend_by_campaign.csv"
    }
  ],
  "kpis": [
    {
      "label": "SQLs",
      "agg": "sum",
      "column": "is_sql"
    },
    {
      "label": "Pipeline value",
      "agg": "sum",
      "column": "pipeline_value_eur",
      "format": "eur"
    },
    {
      "label": "Won revenue",
      "agg": "sum",
      "column": "won_value_eur",
      "format": "eur"
    },
    {
      "label": "Spend",
      "agg": "sum_table",
      "table": "Spend by channel",
      "column": "spend_eur",
      "format": "eur"
    },
    {
      "label": "Cost per SQL",
      "ratio": [
        "Spend",
        "SQLs"
      ],
      "format": "eur"
    },
    {
      "label": "Leads",
      "agg": "count"
    },
    {
      "label": "MQLs",
      "agg": "sum",
      "column": "is_mql"
    },
    {
      "label": "Lead to SQL",
      "ratio": [
        "SQLs",
        "Leads"
      ],
      "format": "pct"
    }
  ],
  "breakdowns": [
    {
      "title": "By channel",
      "group_by": "channel",
      "sort_by": "Leads",
      "metrics": [
        {
          "label": "Leads",
          "agg": "count"
        },
        {
          "label": "MQLs",
          "agg": "sum",
          "column": "is_mql"
        },
        {
          "label": "SQLs",
          "agg": "sum",
          "column": "is_sql"
        },
        {
          "label": "Won",
          "agg": "sum",
          "column": "is_won"
        },
        {
          "label": "Spend",
          "agg": "lookup",
          "table": "Spend by channel",
          "key": "channel",
          "column": "spend_eur",
          "format": "eur"
        },
        {
          "label": "Pipeline value",
          "agg": "sum",
          "column": "pipeline_value_eur",
          "format": "eur"
        },
        {
          "label": "SQL rate",
          "ratio": [
            "SQLs",
            "Leads"
          ],
          "format": "pct",
          "highlight": "high_good"
        },
        {
          "label": "Cost per SQL",
          "ratio": [
            "Spend",
            "SQLs"
          ],
          "format": "eur",
          "highlight": "low_good"
        },
        {
          "label": "Pipeline per €1 spent",
          "ratio": [
            "Pipeline value",
            "Spend"
          ],
          "format": "dec",
          "highlight": "high_good"
        }
      ],
      "chart": {
        "metric": "Cost per SQL"
      }
    },
    {
      "title": "By paid campaign",
      "group_by": "campaign",
      "sort_by": "Leads",
      "exclude": [
        "(none)"
      ],
      "metrics": [
        {
          "label": "Leads",
          "agg": "count"
        },
